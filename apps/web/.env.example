STORAGE_PREFIX=SMILEWEB_
# API_CORE_URL, API_MAIN_URL, API_AUTH_URL, and API_BIG_DATA_URL all default
# to API_BASE_URL + their service's path (see next.config.js) -- on
# staging/prod, where every service sits behind one gateway, changing this
# one var is enough. Locally, where a service often runs standalone on its
# own port instead, set that one var directly to override the default, e.g.:
#   API_CORE_URL=http://localhost:4000
#   API_AUTH_URL=http://localhost:3003
API_BASE_URL=https://smile-health-api.badr.co.id
DEVICE_TYPE=web
DATE_FORMAT=DD/MM/YYYY
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=
# Leave both empty to use Novu Cloud; set both for a self-hosted Novu instance
NEXT_PUBLIC_NOVU_BACKEND_URL=
NEXT_PUBLIC_NOVU_SOCKET_URL=