{
    "name": "@smile/smile-wms",
    "version": "1.0.0",
    "description": "Waste Management System backend (migrated from ../wms + ../wms-migrations)",
    "repository": {
        "type": "git",
        "url": "https://gitlab.badr.co.id/smile-platform/wms/backend.git"
    },
    "license": "ISC",
    "author": "Kanad Chourasia",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "tsc",
        "start": "pm2-runtime dist/server.js",
        "start:dev": "pm2-runtime dist/server.js",
        "dev": "nodemon --watch src --ext ts --exec \"ts-node --transpile-only src/server.ts\"",
        "docs:openapi": "npx @openapitools/openapi-generator-cli generate -i docs/openapi.yaml -g html2 -o docs/openapi",
        "docs:redoc": "npx @redocly/cli build-docs docs/openapi.yaml -o docs/redoc.html",
        "format": "prettier --write 'src/**/*.{ts,js,json,md}'",
        "db:migrate": "sequelize-cli db:migrate",
        "db:rollback": "sequelize-cli db:migrate:undo",
        "db:seed": "sequelize-cli db:seed:all",
        "db:migrate:create": "sequelize-cli migration:generate --name",
        "cron:notif-inactive-users": "ts-node src/cli.ts notif-inactive-users",
        "cron:email-inactive-users": "ts-node src/cli.ts email-inactive-users",
        "cron:maximum-temporary-storage-duration": "ts-node src/cli.ts maximum-temporary-storage-duration",
        "cron:waste-generation-below-monthly-projection": "ts-node src/cli.ts waste-generation-below-monthly-projection",
        "cron:update-status-manual-weighing-approval": "ts-node src/cli.ts update-status-manual-weighing-approval",
        "job:cleanse-asset-dongle-waste-scale": "ts-node src/cli.ts cleanse-asset-dongle-waste-scale"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.840.0",
        "@aws-sdk/s3-request-presigner": "^3.858.0",
        "@smile-health/lib": "workspace:*",
        "amqplib": "^0.10.8",
        "axios": "^1.10.0",
        "commander": "^14.0.3",
        "cors": "^2.8.5",
        "date-fns-tz": "^3.2.0",
        "dotenv": "^16.5.0",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "i18next": "^25.5.2",
        "i18next-fs-backend": "^2.6.0",
        "i18next-http-middleware": "^3.8.0",
        "install": "^0.13.0",
        "ioredis": "^5.6.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.1",
        "multer-s3": "^3.0.1",
        "mysql2": "^3.14.0",
        "pdf-lib": "^1.17.1",
        "pdfmake": "^0.2.20",
        "qrcode": "^1.5.4",
        "sequelize": "^6.37.7",
        "sharp": "^0.34.4",
        "zod": "^3.24.3"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.7",
        "@types/cors": "^2.8.18",
        "@types/express": "^5.0.1",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/multer": "^1.4.13",
        "@types/multer-s3": "^3.0.3",
        "@types/pdfmake": "^0.2.11",
        "@types/qrcode": "^1.5.5",
        "@types/sequelize": "^4.28.20",
        "babel-register": "^6.26.0",
        "nodemon": "^3.1.9",
        "prettier": "^3.5.3",
        "sequelize-auto": "^0.8.8",
        "sequelize-cli": "^6.6.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3"
    },
    "overrides": {
        "validator": "13.15.20",
        "glob": "11.1.0"
    }
}
