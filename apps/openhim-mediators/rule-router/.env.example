# Application
NODE_ENV=development
PORT=4005
LOG_LEVEL=info
# Optional: base path for daily rotating log files (e.g. logs/rule-router.log)
LOG_FILE=

# Database (same DB as interop-service)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smile_interop
DB_USER=smile_user
DB_PASSWORD=smile_password
DATABASE_URL=mysql://<username>:<password>@<host>:<port>/smile_interop

# OpenHIM (same instance as interop-service)
OPENHIM_API_ENDPOINT=https://localhost:8080
OPENHIM_ADMIN_EMAIL=admin@openhim.local
OPENHIM_ADMIN_PASSWORD=openhim_password
OPENHIM_REJECT_UNAUTHORIZED=false
# Client credentials for forwarding events to channels
OPENHIM_CLIENT_ID=smile-app
OPENHIM_CLIENT_SECRET=<openhim-client-secret>
# HTTP endpoint for channel requests (5001 for HTTP or 5000 for HTTPS)
OPENHIM_HTTP_HOST=localhost
OPENHIM_HTTP_PORT=5000

# The hostname/IP that OpenHIM uses to reach THIS mediator service
SERVICE_HOST=localhost

# Timeout in ms for each outbound HTTP request to a routing target (default: 30s)
TARGET_REQUEST_TIMEOUT_MS=30000

# How often (ms) to check DB for routing rule changes. 0 = disabled (default).
# Uses lightweight change-detection (MAX(updated_at) + COUNT(*)) — only reloads when something actually changed.
ROUTING_RULES_REFRESH_INTERVAL_MS=0
