{
  "openapi": "3.0.3",
  "info": {
    "title": "Microplanning - Activity Plan (Step 6)",
    "description": "API endpoints for managing activity plans in the microplanning workflow (Step 6).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "{{baseUrl}}/microplanning/activity-plans",
      "description": "API base URL"
    }
  ],
  "paths": {
    "/microplanning/activity-plans": {
      "get": {
        "tags": ["Activity Plan"],
        "summary": "List Activity Plans",
        "description": "Returns a list of all activity plans for the current microplanning. Mandatory plans are always included with has_completed flag. Optional plans are also returned if created.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Bearer {{token}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ActivityPlanListItem"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Activity Plan"],
        "summary": "Create Activity Plan",
        "description": "Creates a new optional activity plan. Mandatory plans are pre-seeded and cannot be created via this endpoint.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Bearer {{token}}"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateActivityPlanRequest"
              },
              "example": {
                "title": "Imunisasi Tambahan di Posyandu",
                "objective": "Menjangkau balita di posyandu terpencil",
                "frequency": "Setiap bulan",
                "target_group_ids": [3],
                "location_type_ids": [2],
                "implementation_schedule": "Setiap minggu ke-4",
                "material_ids": [10, 25],
                "budget_estimation": 5000000.00,
                "budget_source_id": 3,
                "additional_information": null
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Activity plan created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "id": {
                      "type": "integer",
                      "example": 10
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Validation error"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": ["title is required", "title must be at most 255 characters"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/microplanning/activity-plans/{id}": {
      "get": {
        "tags": ["Activity Plan"],
        "summary": "Get Activity Plan Detail",
        "description": "Returns the full detail of a specific activity plan.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Bearer {{token}}"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Activity plan ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityPlanDetail"
                }
              }
            }
          },
          "404": {
            "description": "Activity plan not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Activity plan not found"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Activity Plan"],
        "summary": "Update Activity Plan",
        "description": "Updates an existing activity plan. For mandatory plans, this sets the has_completed flag to 1 when all required fields are filled.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Bearer {{token}}"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Activity plan ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateActivityPlanRequest"
              },
              "example": {
                "objective": "Updated objective text",
                "frequency": "Dua kali dalam setahun",
                "target_group_ids": [1, 2, 3],
                "location_type_ids": [1],
                "implementation_schedule": "Jadwal baru",
                "material_ids": [10, 20],
                "budget_estimation": 20000000.00,
                "budget_source_id": 5,
                "additional_information": "Catatan tambahan"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activity plan updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "success"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Activity plan not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Activity plan not found"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Activity Plan"],
        "summary": "Delete Activity Plan",
        "description": "Soft-deletes an optional activity plan. Mandatory plans cannot be deleted.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Bearer {{token}}"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Activity plan ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Activity plan deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "success"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Cannot delete mandatory plan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Mandatory activity plans cannot be deleted"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Activity plan not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Activity plan not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/microplanning/activity-plans/summary": {
      "get": {
        "tags": ["Activity Plan"],
        "summary": "Get Activity Plan Summary",
        "description": "Returns a summary of activity plans, showing the count of completed vs total plans.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Bearer {{token}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityPlanSummary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReferenceItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Reference ID"
          },
          "name": {
            "type": "string",
            "description": "Reference name"
          }
        },
        "required": ["id", "name"]
      },
      "ActivityPlanListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Activity plan ID"
          },
          "title": {
            "type": "string",
            "description": "Activity plan title (fixed for mandatory plans)"
          },
          "has_completed": {
            "type": "integer",
            "enum": [0, 1],
            "description": "Whether the plan has been filled out (0 = false, 1 = true)"
          },
          "is_mandatory": {
            "type": "integer",
            "enum": [0, 1],
            "description": "Whether this is a mandatory plan (0 = false, 1 = true)"
          },
          "data": {
            "oneOf": [
              { "$ref": "#/components/schemas/ActivityPlanDetail" },
              { "type": "null" }
            ],
            "description": "Full detail object if has_completed is 1, otherwise null"
          }
        },
        "required": ["id", "title", "has_completed", "is_mandatory", "data"]
      },
      "ActivityPlanDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Activity plan ID"
          },
          "title": {
            "type": "string",
            "description": "Activity plan title (fixed for mandatory plans)"
          },
          "objective": {
            "type": "string",
            "nullable": true,
            "description": "Free-text objective description"
          },
          "frequency": {
            "type": "string",
            "nullable": true,
            "description": "Free-text frequency description"
          },
          "target_groups": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/ReferenceItem"
            },
            "description": "Array of target group objects with id and name (from ws_target_groups)"
          },
          "location_types": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/ReferenceItem"
            },
            "description": "Array of location type objects with id and name (from ws_microplanning_config with key destination_type)"
          },
          "implementation_schedule": {
            "type": "string",
            "nullable": true,
            "description": "Free-text implementation schedule"
          },
          "materials": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/ReferenceItem"
            },
            "description": "Array of material objects with id and name (from ws_material)"
          },
          "budget_estimation": {
            "type": "number",
            "nullable": true,
            "format": "double",
            "description": "Estimated budget amount"
          },
          "budget_source": {
            "oneOf": [
              { "$ref": "#/components/schemas/ReferenceItem" },
              { "type": "null" }
            ],
            "description": "Budget source object with id and name (from ws_budget_sources)"
          },
          "additional_information": {
            "type": "string",
            "nullable": true,
            "description": "Free-text additional information"
          },
          "is_mandatory": {
            "type": "integer",
            "enum": [0, 1],
            "description": "Whether this is a mandatory plan (0 = false, 1 = true)"
          },
          "has_completed": {
            "type": "integer",
            "enum": [0, 1],
            "description": "Completion flag (0 = false, 1 = true)"
          },
          "status": {
            "type": "integer",
            "description": "0 = draft, 1 = submitted"
          }
        },
        "required": ["id", "title", "is_mandatory", "has_completed", "status"]
      },
      "CreateActivityPlanRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "Activity plan title"
          },
          "objective": {
            "type": "string",
            "description": "Free-text objective"
          },
          "frequency": {
            "type": "string",
            "description": "Free-text frequency"
          },
          "target_group_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of target group IDs"
          },
          "location_type_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of location type IDs"
          },
          "implementation_schedule": {
            "type": "string",
            "description": "Free-text schedule"
          },
          "material_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of material IDs"
          },
          "budget_estimation": {
            "type": "number",
            "format": "double",
            "description": "Budget estimation"
          },
          "budget_source_id": {
            "type": "integer",
            "description": "Budget source ID"
          },
          "additional_information": {
            "type": "string",
            "description": "Additional information"
          }
        },
        "required": ["title"]
      },
      "UpdateActivityPlanRequest": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string",
            "description": "Free-text objective"
          },
          "frequency": {
            "type": "string",
            "description": "Free-text frequency"
          },
          "target_group_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of target group IDs"
          },
          "location_type_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of location type IDs"
          },
          "implementation_schedule": {
            "type": "string",
            "description": "Free-text schedule"
          },
          "material_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of material IDs"
          },
          "budget_estimation": {
            "type": "number",
            "format": "double",
            "description": "Budget estimation"
          },
          "budget_source_id": {
            "type": "integer",
            "description": "Budget source ID"
          },
          "additional_information": {
            "type": "string",
            "description": "Additional information"
          }
        }
      },
      "ActivityPlanSummary": {
        "type": "object",
        "properties": {
          "total_plans": {
            "type": "integer",
            "description": "Total number of activity plans"
          },
          "completed_plans": {
            "type": "integer",
            "description": "Number of completed activity plans"
          },
          "mandatory_plans": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "description": "Total mandatory plans (always 2)"
              },
              "completed": {
                "type": "integer",
                "description": "Number of completed mandatory plans"
              }
            }
          },
          "optional_plans": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "description": "Total optional plans"
              },
              "completed": {
                "type": "integer",
                "description": "Number of completed optional plans"
              }
            }
          },
          "progress": {
            "type": "object",
            "properties": {
              "percentage": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Completion percentage"
              }
            }
          }
        }
      }
    }
  }
}