{
  "name": "@smile/wms-encore",
  "version": "1.0.0",
  "description": "Waste Management System backend — Encore.ts rewrite of apps/wms-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pkill -f 'apps/wms-encore/.encore/build/combined/combined/main.mjs' || true; dotenvx run -f .env -- encore run --port 3001",
    "build": "encore build docker wms-encore:latest",
    "test": "encore test",
    "db:seed": "bash scripts/db-seed.sh",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@novu/api": "^3.19.1",
    "amqplib": "^2.3.1",
    "encore.dev": "1.58.9",
    "exceljs": "^4.4.0",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@types/amqplib": "^0.10.8",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
