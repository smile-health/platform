{
  "name": "@smile/smile-wms",
  "version": "1.0.0",
  "description": "Waste Management System backend — Encore.ts rewrite of apps/wms-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pkill -f 'apps/wms-encore/.encore/build/combined/combined/main.mjs' || true; dotenvx run -f .env -- encore run --port 3001",
    "build": "encore build docker wms-encore:latest",
    "test": "encore test",
    "db:seed": "bash scripts/db-seed.sh",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.840.0",
    "@aws-sdk/s3-request-presigner": "^3.858.0",
    "@novu/api": "^3.19.0",
    "encore.dev": "^1.57.13",
    "exceljs": "^4.4.0",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
