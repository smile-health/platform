# MySQL — same shared instance & database that apps/core and apps/main connect to.
# Copy the real values from apps/core/.env (DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME).
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Keycloak — same realm/client that apps/auth-service uses.
# Copy the real values from apps/auth-service/.env.
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
