{
  "name": "@smile/interop-service",
  "version": "1.0.0",
  "description": "Interoperability Layer based upon OpenHIM",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "cli": "node dist/src/cli.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "migration:make": "kysely migrate:make",
    "migration:latest": "kysely migrate:latest",
    "migration:list": "kysely migrate:list"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "kysely": "^0.29.8",
    "mysql2": "^3.24.6",
    "amqplib": "^2.3.1",
    "redis": "^6.3.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "zod": "^4.6.7",
    "znv": "^1.0.0",
    "cloudevents": "^10.0.0",
    "@hono/node-server": "^2.1.7",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "nodemon": "^3.1.14",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0"
  }
}
