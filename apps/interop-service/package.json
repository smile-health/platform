{
  "name": "@smile/interop-service",
  "version": "1.0.0",
  "description": "Interoperability Layer based upon OpenHIM",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "cli": "node dist/src/cli.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "migration:make": "kysely migrate:make",
    "migration:latest": "kysely migrate:latest",
    "migration:list": "kysely migrate:list"
  },
  "dependencies": {
    "hono": "^4.5.0",
    "kysely": "^0.27.6",
    "mysql2": "^3.15.3",
    "amqplib": "^0.10.9",
    "redis": "^4.6.15",
    "pino": "^9.13.1",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "zod": "^3.25.76",
    "znv": "^0.5.0",
    "cloudevents": "^7.0.0",
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "nodemon": "^3.1.4",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2"
  }
}
