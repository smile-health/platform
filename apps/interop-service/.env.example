# Interop Service Environment Template
# Copy this file to .env and fill in the actual values

# ============================================
# Service Configuration
# ============================================
NODE_ENV=development
PORT=4004
LOG_LEVEL=debug
LOG_MODE=development
APP_DEBUG=true
LOG_FILE=logs/interop-service.log 
TIMEOUT=60

# ============================================
# Database Configuration (Shared MySQL Instance)
# ============================================
DB_HOST=<database-host>
DB_PORT=<database-port>
DB_USER=<database-username>
DB_PASSWORD=<database-password>
DB_NAME=smile_interop
DATABASE_URL=mysql://<username>:<password>@<host>:<port>/smile_interop

# ============================================
# RabbitMQ Configuration (Shared Instance)
# ============================================
AMQP_SERVER=<amqp-server-url>
RABBITMQ_HOST=<rabbitmq-host>
RABBITMQ_PORT=<rabbitmq-port>
RABBITMQ_USERNAME=<rabbitmq-username>
RABBITMQ_PASSWORD=<rabbitmq-password>
RABBITMQ_PROTOCOL=<rabbitmq-protocol>
RABBITMQ_VHOST=/
# How many times to republish a failed message before permanently dropping it (default: 3)
RABBITMQ_MAX_RETRIES=3

# ============================================
# Redis Configuration (Shared Instance)
# ============================================
REDIS_HOST=<redis-host>
REDIS_PORT=<redis-port>
REDIS_PASSWORD=<redis-password>
ENABLE_CACHE=false

# ============================================
# OpenHIM Configuration
# ============================================
# For local development with docker-compose running on host
# API endpoint for management operations (HTTPS on port 8080)
OPENHIM_HTTP_PROTOCOL=https
OPENHIM_API_ENDPOINT=http://openhim-core:8080
# Admin credentials for health checks and management
OPENHIM_ADMIN_EMAIL=admin@openhim.local
OPENHIM_ADMIN_PASSWORD=<openhim-admin-password>
# Client credentials for forwarding events to channels
OPENHIM_CLIENT_ID=smile-app
OPENHIM_CLIENT_SECRET=<openhim-client-secret>
# HTTP endpoint for channel requests (5001 for HTTP or 5000 for HTTPS)
OPENHIM_HTTP_HOST=openhim-core
OPENHIM_HTTP_PORT=5000
# Allow self-signed certificates for dev/UAT (set to 'true' for production)
OPENHIM_REJECT_UNAUTHORIZED=false
OPENHIM_REQUEST_TIMEOUT_MS=30000
# Global retry defaults for OpenHIM HTTP calls (per-route values in DB override these)
OPENHIM_MAX_RETRIES=3
OPENHIM_RETRY_BACKOFF_MS=1000
OPENHIM_RETRY_BACKOFF_MULTIPLIER=2

# How often (ms) to check DB for route mapping changes. 0 = disabled. Default: 90s.
# Uses lightweight change-detection (MAX(updated_at) + COUNT(*)) — only reloads when something actually changed.
ROUTE_MAPPING_REFRESH_INTERVAL_MS=90000


# Transformation configuration
# false = pass-through mode (keep original SMILE payload structure)
# true = transform mode (map fields like id → order_id)
ENABLE_PAYLOAD_TRANSFORMATION=false

# ============================================
# Observability
# ============================================
OTLP_ENABLED=false
OTLP_ENDPOINT=<otlp-endpoint>
OTLP_PROTOCOL=http

# ============================================
# Application URLs
# ============================================
FRONTEND_URL=<frontend-url>
APP_URL=<app-url>
CORE_API_URL=<core-api-url>
AUTH_API_URL=<auth-api-url>
AUTH_URL=<auth-url>

# ============================================
# Keycloak Configuration
# ============================================
KEYCLOAK_SERVER_URL=<keycloak-server-url>
KEYCLOAK_REALM=smile
KEYCLOAK_CLIENT_ID=smile
KEYCLOAK_CLIENT_SECRET=<keycloak-client-secret>
REALM_SYSUSER_NAME=sysuser
REALM_SYSUSER_PASS=<realm-sysuser-pass>

# ============================================
# Feature Flags
# ============================================
GROWTHBOOK_API_HOST=https://feature.badr.co.id
GROWTHBOOK_CLIENT_KEY=<growthbook-client-key>
ENVIRONMENT=staging