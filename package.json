{
  "name": "smile-monorepo",
  "private": true,
  "scripts": {
    "init": "pnpm install",
    "reinitiate": "rm -rf node_modules apps/core/node_modules apps/main/node_modules apps/platform/node_modules apps/warehouse-service/node_modules packages/lib/node_modules && pnpm install",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:core-web-wms": "turbo dev --filter=web --filter=@smile/smile-core --filter=@smile/wms-encore",
    "lint": "turbo lint",
    "lint:package": "npx sherif@latest",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test --filter=@smile/smile-warehouse",
    "test:coverage": "turbo run test:coverage --filter=@smile/smile-warehouse",
    "novu:import-workflows": "pnpm --filter @smile-health/lib novu:import-workflows",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "optionalDependencies": {
    "@oven/bun-windows-x64": "^1.4.4",
    "@oven/bun-windows-x64-baseline": "^1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@12.20.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@smile-health/lib": "workspace:*",
    "bun": "^1.4.4",
    "kysely-ctl": "^0.22.0",
    "pnpm": "^12.20.0"
  }
}
