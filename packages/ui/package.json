{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "imports": {
    "#components/*": "./src/components/*/index.ts",
    "#components/layouts/*": "./src/components/layouts/*.tsx",
    "#components/modules/*": "./src/components/modules/*.tsx",
    "#components/icons/*": "./src/components/icons/*.tsx",
    "#constants/*": "./src/constants/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#pages/*": "./src/pages/*.tsx",
    "#pages/locales/en/*": "./src/pages/*/locales/en.json",
    "#pages/locales/id/*": "./src/pages/*/locales/id.json",
    "#services/*": "./src/services/*.ts",
    "#shared/*": "./src/shared/*.ts",
    "#store/*": "./src/store/*.ts",
    "#types/*": "./src/types/*.ts",
    "#utils/*": "./src/utils/*.ts",
    "#provider/*": "./src/provider/*.ts",
    "#locales/*": "./src/locales/*.ts"
  },
  "exports": {
    "./components/*": "./src/components/*/index.ts",
    "./components/layouts/*": "./src/components/layouts/*.tsx",
    "./components/modules/*": "./src/components/modules/*.tsx",
    "./components/icons/*": "./src/components/icons/*.tsx",
    "./constants/*": "./src/constants/*.ts",
    "./pages/*": "./src/pages/*",
    "./provider": "./src/provider/index.tsx",
    "./store/*": "./src/store/*.ts",
    "./styles.css": "./dist/index.css",
    "./hooks/*": "./src/hooks/*.ts",
    "./services/*": "./src/services/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./types/*": "./src/types/*.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "lint": "eslint src/",
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "jest --no-coverage",
    "test:coverage": "jest --coverage",
    "test:update": "jest --updateSnapshot"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chroma-js": "^3.1.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@growthbook/growthbook-react": "^2.0.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^7.0.5",
    "@internationalized/date": "^3.12.4",
    "@novu/nextjs": "^3.19.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chroma-js": "^3.2.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "eslint": "^10.14.0",
    "firebase": "^13.2.0",
    "framer-motion": "^14.10.1",
    "html2canvas": "^1.4.1",
    "i18next": "27.0.1",
    "js-cookie": "^3.0.8",
    "jspdf": "^4.2.1",
    "moment": "^2.31.0",
    "nuqs": "^2.10.2",
    "object-hash": "3.0.0",
    "radix-ui": "^1.8.1",
    "react-aria": "3.53.1",
    "react-chartjs-2": "^5.3.1",
    "react-circle-flags": "^0.0.30",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "18.0.1",
    "react-number-format": "5.4.5",
    "react-otp-input": "^3.1.1",
    "react-phone-number-input": "^3.4.18",
    "react-select": "^5.10.2",
    "react-select-async-paginate": "^0.7.11",
    "react-stately": "3.51.0",
    "tailwind-merge": "^2.6.1",
    "yup": "^1.7.1",
    "zustand": "^5.1.0"
  }
}
